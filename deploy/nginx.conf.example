# Apply only to a new authorized deployment. Supply valid certificates/domain.
limit_req_zone $binary_remote_addr zone=wms_api:10m rate=10r/s;
server {
    listen 443 ssl;
    server_name wms.example.invalid;
    ssl_certificate /run/secrets/tls.crt;
    ssl_certificate_key /run/secrets/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 256k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        limit_req zone=wms_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
}
